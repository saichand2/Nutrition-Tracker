# Optional: leave empty to use browser localStorage only.
# Get these from Supabase → Project Settings → API.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Email confirmation: Supabase → Authentication → URL Configuration → Redirect URLs must include:
#   http://localhost:5173/auth/callback   (dev)
#   https://YOUR_DEPLOYED_ORIGIN/auth/callback   (production)

# ── Push Notifications (Web Push / VAPID) ─────────────────────────────────────
# 1. Generate keys:   node scripts/generate-vapid-keys.mjs
# 2. Paste public key below (front-end only):
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# 3. Set server-side secrets in Supabase (NOT in this file):
#    supabase secrets set \
#      VAPID_PUBLIC_KEY=<same public key> \
#      VAPID_PRIVATE_KEY=<private key> \
#      VAPID_SUBJECT=mailto:your-email@example.com
#
# 4. Deploy the Edge Function:
#    supabase functions deploy send-reminders
#
# The function runs every minute via cron (configured in supabase/config.toml).
